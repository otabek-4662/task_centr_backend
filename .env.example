# ========================================================
# Task Center Backend - Production Environment Variables
# Nusxalash uchun: cp .env.example .env
# ========================================================

# Server porti (default: 8080)
PORT=8080

# PostgreSQL ma'lumotlar bazasi ulanish parametrlari
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taskcenter
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# JWT xavfsizlik sozlamalari (kamida 32 belgili maxfiy kalit majburiy)
JWT_SECRET=your-32-character-ultra-secure-jwt-secret-key-change-this-now!
JWT_EXPIRATION=604800000

# GitHub Webhook (repo Settings -> Webhooks -> Secret)
GITHUB_WEBHOOK_SECRET=

# Email xizmati sozlamalari (Brevo yoki SMTP)
BREVO_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend ilova manzili (email havolalari va taklifnomalar uchun)
APP_FRONTEND_URL=https://task-center-frontend.onrender.com

# Telegram Bot sozlamalari (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_REMINDER_CRON=0 0 18 * * *
TELEGRAM_DIGEST_CRON=0 0 8 * * *

# Production sozlamalari
# Test ma'lumotlarini bazaga qo'shish (production da majburiy false bo'lishi kerak!)
APP_SEED_ENABLED=false

# CORS ruxsat etilgan qo'shimcha domenlar (vergul bilan ajratilgan)
APP_CORS_ALLOWED_ORIGINS=https://task-center-frontend.onrender.com,https://task-manager-frontend.vercel.app

