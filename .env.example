# Task Center Backend - Environment Variables
# Bu faylni .env ga nusxalang va qiymatlarni o'zgartiring:
#   cp .env.example .env

# JWT token uchun maxfiy kalit (kamida 32 ta belgi)
JWT_SECRET=your-secret-key-here-change-this-to-something-secure-at-least-32-chars

# GitHub webhook imzosi (GitHub -> repo Settings -> Webhooks -> Secret bilan bir xil).
# Bo'sh bo'lsa /api/webhooks/github barcha so'rovlarni rad etadi (403)
GITHUB_WEBHOOK_SECRET=
